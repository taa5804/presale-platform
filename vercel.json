{
  "rewrites": [
    {
      "source": "/presale-list",
      "destination": "/presale-list.html"
    },
    {
      "source": "/app-install",
      "destination": "/app-install.html"
    },
    {
      "source": "/head-admin",
      "destination": "/head-admin.html"
    },
    {
      "source": "/room-manager",
      "destination": "/room-manager.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/price",
      "destination": "/price.html"
    },
    {
      "source": "/presale",
      "destination": "/presale.html"
    },
    {
      "source": "/sale-detail",
      "destination": "/sale-detail.html"
    },
    {
      "source": "/sale-coupon",
      "destination": "/sale-coupon.html"
    },
    {
      "source": "/mart-search/:code/:mart",
      "destination": "/api/mart-page?code=:code&mart=:mart"
    },
    {
      "source": "/sitemaps/marts-:page.xml",
      "destination": "/api/mart-sitemap?page=:page"
    },
    {
      "source": "/mart-sitemap.xml",
      "destination": "/api/mart-sitemap-index"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/broker-landing.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/presale-list.xlsx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"presale-list-2026.xlsx\"; filename*=UTF-8''%EC%A0%84%EA%B5%AD_%EB%B6%84%EC%96%91%EC%A4%91_%EB%B6%84%EC%96%91%EC%98%88%EC%A0%95_%EB%B6%84%EC%96%91%EC%82%AC%EB%A6%AC%EC%8A%A4%ED%8A%B8_2026.xlsx"
        }
      ]
    },
    {
      "source": "/presale-list.csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"presale-list-2026.csv\"; filename*=UTF-8''%EC%A0%84%EA%B5%AD_%EB%B6%84%EC%96%91%EC%A4%91_%EB%B6%84%EC%96%91%EC%98%88%EC%A0%95_%EB%B6%84%EC%96%91%EC%82%AC%EB%A6%AC%EC%8A%A4%ED%8A%B8_2026.csv"
        }
      ]
    }
  ]
}